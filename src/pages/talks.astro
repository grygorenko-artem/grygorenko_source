---
import Base from '@/layouts/Base.astro';
import { talks } from '@/data/talks';

const byYear = talks.reduce<Record<number, typeof talks>>((acc, talk) => {
  const year = new Date(talk.date).getFullYear();
  (acc[year] ??= []).push(talk);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Base title="Talks & Webinars">
  <h2 class="page-title">Talks & Webinars</h2>

  <div class="filters">
    <button class="filter-btn active" data-lang="all">All</button>
    <button class="filter-btn" data-lang="EN">English</button>
    <button class="filter-btn" data-lang="UA">Ukrainian</button>
  </div>

  {years.map((year) => (
    <div class="year-group" data-year={year}>
      <div class="year-label">{year}</div>
      <div class="talk-list">
        {byYear[year].map((talk) => {
          const d = new Date(talk.date);
          const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          return (
            <div class="talk" data-lang={talk.language}>
              <div class="talk-date">{dateStr}</div>
              <div class="talk-body">
                <div class="talk-title">
                  {talk.recording
                    ? <a href={talk.recording} target="_blank" rel="noopener">{talk.title}</a>
                    : talk.title
                  }
                </div>
                <div class="talk-meta">
                  <span class="talk-event">{talk.event}</span>
                  <span class="talk-badge">{talk.language}</span>
                  <span class="talk-badge">{talk.format}</span>
                  {talk.location && <span class="talk-badge">{talk.location}</span>}
                </div>
                {(talk.recording || talk.slides) && (
                  <div class="talk-links">
                    {talk.recording && (
                      <a href={talk.recording} target="_blank" rel="noopener" class="talk-link">
                        ▶ Recording
                      </a>
                    )}
                    {talk.slides && (
                      <a href={talk.slides} target="_blank" rel="noopener" class="talk-link">
                        ↗ Slides
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const talks = document.querySelectorAll<HTMLElement>('.talk');
  const yearGroups = document.querySelectorAll<HTMLElement>('.year-group');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const lang = btn.dataset.lang!;

      talks.forEach(talk => {
        const show = lang === 'all' || talk.dataset.lang === lang;
        talk.style.display = show ? '' : 'none';
      });

      yearGroups.forEach(group => {
        const visible = [...group.querySelectorAll<HTMLElement>('.talk')]
          .some(t => t.style.display !== 'none');
        group.style.display = visible ? '' : 'none';
      });
    });
  });
</script>

<style>
  .filters {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    font-size: 0.775rem;
    font-weight: 500;
    font-family: var(--font-body);
    padding: 0.35rem 1rem;
    border: none;
    border-right: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .filter-btn:last-child {
    border-right: none;
  }

  .filter-btn.active {
    background: var(--accent);
    color: #fff;
  }

  .filter-btn:hover:not(.active) {
    background: var(--sidebar-bg);
    color: var(--text);
  }

  .year-group {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .year-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    padding-top: 0.35rem;
    width: 36px;
    flex-shrink: 0;
  }

  .talk-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .talk {
    display: flex;
    gap: 1.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .talk:first-child { border-top: 1px solid var(--border); }

  .talk-date {
    font-size: 0.775rem;
    color: var(--text-secondary);
    white-space: nowrap;
    width: 48px;
    flex-shrink: 0;
    padding-top: 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .talk-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .talk-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
  }

  .talk-title a {
    color: var(--text);
    text-decoration: none;
  }

  .talk-title a:hover { color: var(--accent); }

  .talk-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .talk-event {
    font-size: 0.775rem;
    color: var(--text-secondary);
  }

  .talk-badge {
    font-size: 0.675rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .talk-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.1rem;
  }

  .talk-link {
    font-size: 0.775rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .talk-link:hover { color: var(--accent-hover); }
</style>
