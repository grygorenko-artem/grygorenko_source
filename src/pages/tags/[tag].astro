---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set(posts.flatMap((p) => p.data.tags.map((t) => t.toLowerCase())));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.map((t) => t.toLowerCase()).includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`Tag: ${tag}`}>
  <h2 class="page-title">#{tag}</h2>
  <ul class="post-list">
    {posts.map((post) => {
      const dateStr = post.data.date.toLocaleDateString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric',
      });
      return (
        <li>
          <span class="post-date">{dateStr}</span>
          <a href={`/blog/${post.slug}`} class="post-link">{post.data.title}</a>
        </li>
      );
    })}
  </ul>
</Base>
