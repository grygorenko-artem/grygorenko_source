---
interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Blog about testing, QA, management and people.' } = Astro.props;
const siteTitle = '{∀}.Grygorenko';
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;

const nav = [
  { label: 'Posts',    href: '/' },
  { label: 'Tags',     href: '/tags' },
  { label: 'About Me', href: '/about' },
  { label: 'My Talks', href: '/talks' },
];

const social = [
  { label: 'Twitter / X', href: 'https://twitter.com/grygorenkoartem', icon: 'twitter' },
  { label: 'Telegram',    href: 'https://t.me/a_grygorenko',           icon: 'telegram' },
  { label: 'LinkedIn',    href: 'https://www.linkedin.com/in/artem-grygorenko/', icon: 'linkedin' },
  { label: 'Instagram',   href: 'https://instagram.com/artem.grygorenko', icon: 'instagram' },
  { label: 'RSS',         href: '/rss.xml', icon: 'rss' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <div class="profile">
          <a href="/" class="logo">{siteTitle}</a>
          <img
            class="avatar"
            src="https://github.com/grygorenko-artem.png"
            alt="Artem Grygorenko"
            width="64"
            height="64"
          />
          <p class="name">Artem Grygorenko</p>
          <p class="role">Community Executive Officer</p>
        </div>

        <nav class="nav">
          {nav.map(({ label, href }) => {
            const isActive = href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(href);
            return (
              <a href={href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {label}
              </a>
            );
          })}
        </nav>

        <form
          action="https://buttondown.com/api/emails/embed-subscribe/grygorenko"
          method="post"
          class="subscribe-form"
        >
          <input type="email" name="email" placeholder="your@email.com" required class="subscribe-input" />
          <button type="submit" class="subscribe-btn">Subscribe</button>
        </form>

        <div class="social">
          {social.map(({ label, href, icon }) => (
            <a href={href} class="social-link" aria-label={label} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              {icon === 'twitter' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
              {icon === 'telegram' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>}
              {icon === 'linkedin' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
              {icon === 'instagram' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>}
              {icon === 'rss' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <main class="content">
      <slot />
    </main>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --sidebar-width: 270px;
    --sidebar-bg: #f4f4f4;
    --content-bg: #ffffff;
    --border: #e4e4e4;
    --text: #141414;
    --text-secondary: #888;
    --accent: #4253e8;
    --accent-hover: #2f3ec4;
    --link-hover: #4253e8;
    --font-body: 'Inter', system-ui, -apple-system, sans-serif;
    --font-display: 'Geist Mono', 'Courier New', monospace;
  }

  html { font-size: 16px; }

  body {
    font-family: var(--font-body);
    background: var(--content-bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
  }

  .layout {
    display: flex;
    min-height: 100vh;
  }

  /* ── Sidebar ── */
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
  }

  .sidebar-inner {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    overflow-y: auto;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
    display: block;
    margin-bottom: 2rem;
  }

  .logo:hover { color: var(--accent); }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: block;
    margin-bottom: 0.875rem;
    border: 2px solid var(--border);
  }

  .name {
    font-family: var(--font-display);
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
  }

  .role {
    font-size: 0.775rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  /* ── Nav ── */
  .nav {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    flex: 1;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color 0.15s;
    letter-spacing: 0.01em;
  }

  .nav-link:hover { color: var(--text); }

  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  /* ── Social ── */
  .social {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .social-link {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .social-link:hover { color: var(--accent); }
  .social-link svg { width: 17px; height: 17px; }

  /* ── Subscribe ── */
  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .subscribe-input {
    width: 100%;
    padding: 0.45rem 0.65rem;
    font-size: 0.8rem;
    font-family: var(--font-body);
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--content-bg);
    color: var(--text);
    outline: none;
    box-sizing: border-box;
  }

  .subscribe-input:focus { border-color: var(--accent); }

  .subscribe-btn {
    padding: 0.45rem 0.65rem;
    font-size: 0.8rem;
    font-family: var(--font-body);
    font-weight: 600;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .subscribe-btn:hover { background: var(--accent-hover); }

  /* ── Content ── */
  .content {
    flex: 1;
    min-width: 0;
    padding: 3rem 4rem;
    max-width: 800px;
  }

  /* ── Post list ── */
  .post-list { list-style: none; }

  .post-list li {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-list li:last-child { border-bottom: none; }

  .post-date {
    font-size: 0.775rem;
    color: var(--text-secondary);
    white-space: nowrap;
    width: 100px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .post-link {
    font-size: 0.9375rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 450;
    transition: color 0.15s;
  }

  .post-link:hover { color: var(--accent); }

  /* ── Article ── */
  .article-header { margin-bottom: 2.5rem; }

  .article-title {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .article-meta {
    font-size: 0.775rem;
    color: var(--text-secondary);
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .article-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .tag {
    font-size: 0.725rem;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.15s, border-color 0.15s;
  }

  .tag:hover { color: var(--accent); border-color: var(--accent); }

  /* ── Prose ── */
  .prose { line-height: 1.8; }

  .prose h2, .prose h3, .prose h4 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 2.25rem 0 0.75rem;
    color: var(--text);
  }

  .prose h2 { font-size: 1.35rem; }
  .prose h3 { font-size: 1.1rem; }
  .prose p { margin-bottom: 1.25rem; color: var(--text); }
  .prose a { color: var(--accent); text-decoration-thickness: 1px; }
  .prose a:hover { color: var(--accent-hover); }
  .prose ul, .prose ol { margin: 0 0 1.25rem 1.5rem; color: var(--text); }
  .prose li { margin-bottom: 0.4rem; }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding: 0.5rem 0 0.5rem 1.25rem;
    color: var(--text-secondary);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .prose pre {
    background: #f6f6f6;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }

  .prose code {
    font-size: 0.875em;
    background: #f0f0f0;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--accent);
  }

  .prose pre code { background: none; padding: 0; color: inherit; }
  .prose img { max-width: 100%; border-radius: 8px; margin: 1.25rem 0; border: 1px solid var(--border); }
  .prose hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

  /* ── Page heading ── */
  .page-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
    color: var(--text);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .layout { flex-direction: column; }
    .sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
    .sidebar-inner { height: auto; padding: 1.25rem 1.5rem; }
    .logo { margin-bottom: 1.25rem; }
    .avatar { width: 48px; height: 48px; }
    .role { margin-bottom: 1rem; }
    .nav { flex-direction: row; flex-wrap: wrap; gap: 0.25rem 1rem; }
    .social { margin-top: 1rem; padding-top: 1rem; }
    .content { padding: 1.5rem; }
  }
</style>
